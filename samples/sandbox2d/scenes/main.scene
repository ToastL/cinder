version 3
actors {
    actor {
        id 1
        name "Camera"
        attributes {
            speed 200
        }
        components {
            Camera {
                projection "orthographic"
                clearColor 0.05 0.05 0.08 1
                virtualSize 640 360
            }
            Script {
                file "scripts/camera2d.lua"
            }
        }
    }
    actor {
        id 2
        name "Spawner"
        attributes {
            boxScript "scripts/riser.lua"
            lifetime 6
            maxSize 18
            minSize 4
        }
        components {
            Script {
                file "scripts/spawner.lua"
            }
        }
    }
    actor {
        id 3
        name "Cursor"
        components {
            SpriteRenderer {
                size 6 6
            }
            Script {
                file "scripts/cursor.lua"
            }
        }
    }
}
